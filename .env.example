# =============================================================================
# LOCAL DEVELOPMENT — copy to .env (gitignored). Never commit real values.
# =============================================================================
# For Vercel / public demo, see .env.production.example and docs/PUBLIC_DEPLOY.md
# =============================================================================

# API server URL — 3DAIGC-API (https://github.com/AlfaOmegaGrafx/3DAIGC-API). Required for AI generation.
# Local default when you run the API on this machine (uvicorn, port 8000):
#   VITE_API_ENDPOINT=http://127.0.0.1:8000
# When the Vite dev server uses HTTPS (WebXR / Android WebView), http:// API URLs are blocked
# (mixed content + ERR_CLEARTEXT_NOT_PERMITTED). Use the dev proxy instead:
#   DEV_API_PROXY_TARGET=http://127.0.0.1:8000
#   VITE_API_ENDPOINT=/__dev_dgx_proxy
# Requests go to same-origin https://YOUR_PC:3000/__dev_dgx_proxy/... and Vite forwards to the target.
VITE_API_ENDPOINT=http://127.0.0.1:8000
# Real HTTP(S) API base for dev proxy only (not exposed to the client). Omit if not using /__dev_dgx_proxy.
DEV_API_PROXY_TARGET=

# Job status path for 3DAIGC-API / DGX Spark. App polls GET {apiEndpoint}/{path}/{jobId}. Required for job completion polling.
VITE_JOB_STATUS_PATH=api/v1/system/jobs

# If Vite shows "Unable to watch for file changes", use polling instead of native watchers:
#   npm run dev:polling   (Windows/Mac/Linux — cross-env)
# Or uncomment:
# VITE_USE_POLLING=1

# Loot assets — choose ONE mode (see docs/VERCEL_LOOT_ASSETS.md):
# CDN (recommended on Surface when public/loot-assets junction breaks Vite watchers):
#   VITE_ASSET_PATH=https://m3-org.github.io/loot-assets/
#   Then: npm run get-assets  (downloads UI SVG icons into public/loot-assets/icons only)
# Local offline (full clone at ../loot-assets, junction public/loot-assets):
#   Leave VITE_ASSET_PATH empty, run npm run get-assets or .\scripts\link-loot-assets.ps1
VITE_ASSET_PATH=

# When 3DAIGC-API has security.api_key_required, set Bearer token here (same value the backend expects after "Bearer ").
# VITE_3DAIGC_API_KEY=

# Longest side (px) for image-to-3D input before upload (default 2048; many APIs reject larger images).
# VITE_3DAIGC_MAX_IMAGE_SIDE=2048
# --- Secrets below: LOCAL ONLY. Never set on Vercel (build will fail). ---
VITE_OPENSEA_KEY=
VITE_HELIUS_KEY=
VITE_VALIDATION_SERVER_URL=http://localhost:3000

# Playwright MCP Bridge: set in env where Cursor runs so Playwright MCP can connect to the extension. Do not commit the real token.
# PLAYWRIGHT_MCP_EXTENSION_TOKEN=

# RP1 Scene Assembler (MSF on DGX :8443) — NOT XR Voice
# Surface: npm run msf-proxy  →  https://<Surface-LAN>:8453  (port 8453 only)
# VITE_MSF_PUBLIC_URL=https://<SURFACE_LAN_IP>:8453
# VITE_RP1_FABRIC_MSF_URL=https://<SURFACE_LAN_IP>:8453/fabric/sample.msf
# Tailscale attach (RP1 dev center): https://dgx-spark.<TAILNET_ID>.ts.net/fabric/sample.msf
# VITE_RP1_COMPANY_ID=spacetimefabric

# XR Voice sidebar iframe (Spark hub on DGX :8088) — NOT Scene Assembler
# Surface: npm run xr-hub-proxy  →  https://<Surface-LAN>:8443  (port 8443 only)
# Run both: npm run dev:spark-proxies
# Vercel production (Tailscale Funnel — public HTTPS, not a secret):
# VITE_XR_HUB_URL=https://dgx-spark.<TAILNET_ID>.ts.net:8088
# Local Surface dev (LAN proxy — do NOT use on Vercel):
# VITE_XR_HUB_URL=https://<SURFACE_LAN_IP>:8443
# Do NOT use DGX LAN :8088 in Vite iframe on Surface (self-signed cert); funnel URL is OK on Vercel.

# Optional companion launch URL for local Studio. Leave unset on the public demo.
# VITE_COMPANION_URL=
# VITE_DGX_LAN_IP=

# Grounding DINO zero-shot detection (DGX proxy :8456) — Unity-MetaXR-AI-ZeroShot web port
# DGX: NGC_API_KEY=nvapi-... npm run grounding-dino-proxy
# Uses same NGC key as xr-ai (build.nvidia.com). Key stays on DGX — never VITE_*.
# VITE_GROUNDING_DINO_PROXY_URL=https://<SURFACE_LAN_IP>:8456